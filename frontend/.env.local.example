# Docify Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Contract addresses (deployed by backend/scripts/deploy.js)
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=

# Network configuration
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=1337

# Block explorer URL (optional, for transaction links)
# Sepolia: https://sepolia.etherscan.io
# Vanar: https://explorer.vanarchain.com
NEXT_PUBLIC_EXPLORER_URL=
